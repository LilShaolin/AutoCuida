<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacío reutilizable: icono, título y texto explicativo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_xxl"
    android:paddingTop="@dimen/espacio_xxl"
    android:paddingEnd="@dimen/espacio_xxl"
    android:paddingBottom="@dimen/espacio_xl">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/fondo_avatar">

        <ImageView
            android:id="@+id/vacio_icono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnPrimaryContainer"
            tools:src="@drawable/ic_coche" />
    </FrameLayout>

    <TextView
        android:id="@+id/vacio_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AutoCuida.TituloSeccion"
        tools:text="@string/vehiculos_vacio_titulo" />

    <TextView
        android:id="@+id/vacio_texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:gravity="center"
        android:maxWidth="360dp"
        android:textAppearance="@style/TextAppearance.AutoCuida.Cuerpo"
        tools:text="@string/vehiculos_vacio_texto" />
</LinearLayout>
