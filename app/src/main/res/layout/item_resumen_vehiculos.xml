<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de la lista: número de vehículos y avisos pendientes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/espacio_s"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_s"
    android:paddingBottom="@dimen/espacio_xs">

    <TextView
        android:id="@+id/resumen_vehiculos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.AutoCuida.Etiqueta"
        tools:text="3 vehículos" />

    <TextView
        android:id="@+id/resumen_avisos"
        style="@style/Widget.AutoCuida.Insignia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2 avisos pendientes" />
</LinearLayout>
