<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_s"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/ancho_maximo_contenido">

            <!-- Filtros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_periodo"
                    style="@style/Widget.AutoCuida.CampoTexto.Desplegable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:hint="@string/gastos_periodo">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/et_periodo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_vehiculo"
                    style="@style/Widget.AutoCuida.CampoTexto.Desplegable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:hint="@string/gastos_vehiculo">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/et_vehiculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Total -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AutoCuida.Tarjeta.Destacada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        android:id="@+id/total_etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoCuida.Etiqueta"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        tools:text="Gasto total 2026" />

                    <TextView
                        android:id="@+id/total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AutoCuida.Cifra"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        tools:text="1.245,80 €" />

                    <TextView
                        android:id="@+id/total_registros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        tools:text="8 mantenimientos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/vacio"
                layout="@layout/vista_estado_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Gráfica de barras -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_l">

                        <TextView
                            android:id="@+id/titulo_grafica"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.AutoCuida.TituloTarjeta"
                            tools:text="@string/gastos_grafica_mensual" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/grafica"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/altura_grafica"
                            android:layout_marginTop="@dimen/espacio_s" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Por tipo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/espacio_l"
                        android:paddingBottom="@dimen/espacio_s">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_l"
                            android:text="@string/gastos_por_tipo"
                            android:textAppearance="@style/TextAppearance.AutoCuida.TituloTarjeta" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/lista_tipos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_gasto_agrupado" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Por vehículo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tarjeta_vehiculos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/espacio_l"
                        android:paddingBottom="@dimen/espacio_s">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_l"
                            android:text="@string/gastos_por_vehiculo"
                            android:textAppearance="@style/TextAppearance.AutoCuida.TituloTarjeta" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/lista_vehiculos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_gasto_agrupado" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Historial del periodo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xl"
                    android:layout_marginBottom="@dimen/espacio_s"
                    android:text="@string/gastos_historial"
                    android:textAppearance="@style/TextAppearance.AutoCuida.TituloSeccion" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lista_historial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_mantenimiento" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
