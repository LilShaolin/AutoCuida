<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y transferencia entre dispositivos (Android 12 y posteriores). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
